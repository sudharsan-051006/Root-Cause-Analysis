# QualiRoot AI - Backend Configuration

# ==============================================================================
# DATABASE CONFIGURATION (NEON POSTGRESQL / LOCAL POSTGRESQL)
# ==============================================================================
# 1. NEON CLOUD POSTGRESQL (Recommended for cloud persistence):
# Copy the connection string directly from your Neon dashboard (https://console.neon.tech)
# Example (Pooled or Direct endpoint):
# DATABASE_URL=postgresql://user:password@ep-xyz-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# 2. LOCAL POSTGRESQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qualiroot_db
#
DATABASE_URL=postgresql://user:password@ep-xyz-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# Fallback to embedded persistent SQLite if PostgreSQL / Neon connection fails
ALLOW_SQLITE_FALLBACK=true

# ==============================================================================
# GROQ AI CONFIGURATION
# ==============================================================================
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Currently supported active models on Groq:
# - llama-3.3-70b-versatile (Recommended flagship for complex pharmaceutical RCA)
# - llama-3.1-8b-instant (Fast, lightweight alternative)
# - deepseek-r1-distill-llama-70b (Deep reasoning alternative)
GROQ_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=15
